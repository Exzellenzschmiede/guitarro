    },
    "tutorial.category.rhythm": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhythmus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhythm"
          }
        }
      }
    },
    "tutorial.category.technique": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Technik"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technique"
          }
        }
      }
    },
    "tutorial.changes.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau auf beide Griffe: Bei Em → Am wandern zwei Finger nur eine Saite weiter, ein Finger kommt dazu. Bewege die Finger als Gruppe, nicht einzeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at both shapes: going from Em to Am, two fingers move just one string over and one finger joins. Move the fingers as a group, not one by one."
          }
        }
      }
    },
    "tutorial.changes.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was bewegt sich?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What moves?"
          }
        }
      }
    },
    "tutorial.changes.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe den Wechsel zuerst ohne Anschlag, ganz langsam. Erst wenn die Bewegung sitzt, kommt das Tempo. Ein Metronom hilft: Wechsel auf jede Eins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practise the change without strumming first, very slowly. Speed comes only once the motion is automatic. A metronome helps: change on every downbeat."
          }
        }
      }
    },
    "tutorial.changes.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam ist schnell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow is fast"
          }
        }
      }
    },
    "tutorial.changes.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle, wie viele saubere Wechsel du in einer Minute schaffst. Merk dir die Zahl und versuche, sie jeden Tag zu schlagen. Los geht's!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count how many clean changes you manage in one minute. Remember the number and try to beat it every day. Go!"
          }
        }
      }
    },
    "tutorial.changes.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ein-Minuten-Challenge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one-minute challenge"
          }
        }
      }
    },
    "tutorial.changes.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell und sauber zwischen Griffen wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between shapes fast and clean."
          }
        }
      }
    },
    "tutorial.changes.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkordwechsel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord changes"
          }
        }
      }
    },
    "tutorial.chord.placing %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finger %lld setzen …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing finger %lld …"
          }
        }
      }
    },
    "tutorial.chord.strum": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Finger sitzen – anschlagen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All fingers down – strum!"
          }
        }
      }
    },
    "tutorial.completed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektion abgeschlossen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesson completed"
          }
        }
      }
    },
    "tutorial.finish": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektion abschließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish lesson"
          }
        }
      }
    },
    "tutorial.firstChords.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der einfachste Akkord: nur zwei Finger. Mittel- und Ringfinger im zweiten Bund auf A- und D-Saite. Alle sechs Saiten dürfen klingen. Schlag langsam an und hör, ob jede Saite sauber klingt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The easiest chord: just two fingers. Middle and ring finger on the second fret of the A and D strings. All six strings can ring. Strum slowly and listen for every string sounding clean."
          }
        }
      }
    },
    "tutorial.firstChords.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Moll"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E minor"
          }
        }
      }
    },
    "tutorial.firstChords.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiebe die beiden Finger von Em eine Saite tiefer (D und G) und setze den Zeigefinger im ersten Bund auf die H-Saite. Die tiefe E-Saite bleibt stumm. Der Zeigefinger darf die hohe E-Saite nicht berühren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move both fingers from Em one string down (D and G) and add your index finger on the first fret of the B string. The low E string stays silent. The index finger must not touch the high E string."
          }
        }
      }
    },
    "tutorial.firstChords.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A-Moll"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minor"
          }
        }
      }
    },
    "tutorial.firstChords.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitarro hört mit. Spiele beide Akkorde nacheinander, jeweils mit einem klaren Schlag. Sobald die App den Griff erkennt, leuchtet er auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitarro is listening. Play both chords one after the other, each with one clear strum. As soon as the app recognises the shape, it lights up."
          }
        }
      }
    },
    "tutorial.firstChords.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör hin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen"
          }
        }
      }
    },
    "tutorial.firstChords.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Em und Am – zwei Griffe, die fast jeder Song braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Em and Am, two shapes almost every song needs."
          }
        }
      }
    },
    "tutorial.firstChords.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ersten Akkorde"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first chords"
          }
        }
      }
    },
    "tutorial.gcd.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelfinger im dritten Bund auf der tiefen E-Saite, Zeigefinger im zweiten Bund auf der A-Saite, Ringfinger im dritten Bund auf der hohen E-Saite. Ein großer, offener Klang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle finger on the third fret of the low E string, index finger on the second fret of the A string, ring finger on the third fret of the high E string. A big, open sound."
          }
        }
      }
    },
    "tutorial.gcd.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "G-Dur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "G major"
          }
        }
      }
    },
    "tutorial.gcd.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringfinger im dritten Bund auf der A-Saite, Mittelfinger im zweiten Bund auf der D-Saite, Zeigefinger im ersten Bund auf der H-Saite. Die tiefe E-Saite bleibt stumm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ring finger on the third fret of the A string, middle finger on the second fret of the D string, index finger on the first fret of the B string. The low E string stays silent."
          }
        }
      }
    },
    "tutorial.gcd.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "C-Dur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "C major"
          }
        }
      }
    },
    "tutorial.gcd.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleines Dreieck: Zeigefinger im zweiten Bund auf der G-Saite, Ringfinger im dritten Bund auf der H-Saite, Mittelfinger im zweiten Bund auf der hohen E-Saite. Nur die vier hohen Saiten anschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little triangle: index finger on the second fret of the G string, ring finger on the third fret of the B string, middle finger on the second fret of the high E string. Strum only the four high strings."
          }
        }
      }
    },
    "tutorial.gcd.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "D-Dur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "D major"
          }
        }
      }
    },
    "tutorial.gcd.step4.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "G → C → D → G ist die berühmteste Akkordfolge der Welt. Spiele jeden Akkord viermal und wechsle dann. Guitarro prüft, ob alle drei Griffe sauber kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "G → C → D → G is the most famous chord progression in the world. Play each chord four times, then change. Guitarro checks that all three shapes come out clean."
          }
        }
      }
    },
    "tutorial.gcd.step4.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammen spielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play them together"
          }
        }
      }
    },
    "tutorial.gcd.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drei Akkorde hinter tausenden Songs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three chords behind thousands of songs."
          }
        }
      }
    },
    "tutorial.gcd.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "G, C und D"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "G, C and D"
          }
        }
      }
    },
    "tutorial.posture.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich auf die vordere Hälfte eines Stuhls ohne Armlehnen. Die Gitarre liegt auf dem rechten Oberschenkel, der Hals zeigt leicht nach oben. Der Rücken bleibt gerade, die Schultern locker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit on the front half of a chair without armrests. The guitar rests on your right thigh with the neck pointing slightly upward. Keep your back straight and your shoulders loose."
          }
        }
      }
    },
    "tutorial.posture.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitting"
          }
        }
      }
    },
    "tutorial.posture.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Daumen liegt hinter dem Hals, etwa auf Höhe des Mittelfingers. Die Finger sind gewölbt und drücken mit den Kuppen kurz hinter dem Bundstäbchen. So klingen die Saiten sauber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your thumb rests behind the neck, roughly level with your middle finger. Curve your fingers and press with the fingertips just behind the fret wire. That is what makes the strings ring cleanly."
          }
        }
      }
    },
    "tutorial.posture.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Greifhand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fretting hand"
          }
        }
      }
    },
    "tutorial.posture.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Unterarm ruht auf der Zarge, das Handgelenk bleibt locker. Der Anschlag kommt aus dem Handgelenk, nicht aus dem Ellenbogen. Halte das Plektrum leicht, aber sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your forearm rests on the guitar's edge and the wrist stays loose. Strums come from the wrist, not the elbow. Hold the pick lightly but securely."
          }
        }
      }
    },
    "tutorial.posture.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlaghand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strumming hand"
          }
        }
      }
    },
    "tutorial.posture.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sitzt du entspannt und hältst die Gitarre richtig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit relaxed and hold the guitar the right way."
          }
        }
      }
    },
    "tutorial.posture.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltung & Hände"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posture & hands"
          }
        }
      }
    },
    "tutorial.strum.listen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster anhören"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen to the pattern"
          }
        }
      }
    },
    "tutorial.strumming.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles beginnt mit vier gleichmäßigen Abschlägen pro Takt: 1 – 2 – 3 – 4. Hör dir das Muster an und spiele mit. Die Hand bewegt sich locker aus dem Handgelenk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything starts with four even downstrokes per bar: 1 – 2 – 3 – 4. Listen to the pattern and play along. The hand moves loosely from the wrist."
          }
        }
      }
    },
    "tutorial.strumming.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viertel-Abschläge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quarter-note downstrokes"
          }
        }
      }
    },
    "tutorial.strumming.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab – Ab – Auf – Auf – Ab – Auf. Das Geheimnis: Die Hand pendelt ununterbrochen auf und ab, auch wenn sie mal keine Saite trifft. So bleibt der Rhythmus stabil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down – Down – Up – Up – Down – Up. The secret: the hand keeps swinging up and down without pause, even when it misses the strings. That keeps the rhythm steady."
          }
        }
      }
    },
    "tutorial.strumming.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lagerfeuer-Muster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The campfire pattern"
          }
        }
      }
    },
    "tutorial.strumming.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt bringt das Muster einen Song zum Leben. Spiele „Bruder Jakob“ in langsamem Tempo und halte das Muster durch – Guitarro hört auf die Akkorde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now the pattern brings a song to life. Play “Frère Jacques” at a slow tempo and keep the pattern going. Guitarro listens for the chords."
          }
        }
      }
    },
    "tutorial.strumming.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
