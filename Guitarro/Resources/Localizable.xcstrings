    "story.tagline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine staubige Gitarre, ein Brief von Oma und eine Hafenstadt voller Musik. Lerne spielen, indem du die Geschichte erlebst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dusty guitar, a letter from grandma and a harbour town full of music. Learn to play by living the story."
          }
        }
      }
    },
    "story.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
