    "usersongs.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere einen Song aus deiner Mediathek oder eine Datei. Guitarro findet Akkorde, Tonart und Tempo, du kannst ihn verlangsamen und Teile loopen, während die App zuhört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a song from your library or a file. Guitarro finds the chords, key and tempo, and you can slow it down and loop parts while it listens."
          }
        }
      }
    },
