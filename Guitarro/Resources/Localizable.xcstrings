    "tutorial.strumming.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom gleichmäßigen Abschlag zum ersten Groove."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From steady downstrokes to your first groove."
          }
        }
      }
    },
