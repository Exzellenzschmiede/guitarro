    "tutorial.barre.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeigefinger legt sich flach über alle sechs Saiten im ersten Bund. Die anderen Finger greifen die E-Dur-Form dahinter: Mittelfinger im zweiten Bund auf der G-Saite, Ring- und kleiner Finger im dritten Bund auf A- und D-Saite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The index finger lies flat across all six strings at the first fret. The other fingers form the E-major shape behind it: middle finger on the second fret of the G string, ring and little finger on the third fret of the A and D strings."
          }
        }
      }
    },
    "tutorial.barre.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Griff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape"
          }
        }
      }
    },
    "tutorial.barre.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolle den Zeigefinger leicht auf die Außenkante und zieh den Hals sanft zu dir, statt nur zu drücken. Der Daumen liegt mittig hinter dem Hals, gegenüber dem Zeigefinger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll the index finger slightly onto its outer edge and pull the neck gently towards you instead of just squeezing. The thumb sits centred behind the neck, opposite the index finger."
          }
        }
      }
    },
    "tutorial.barre.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebel statt Kraft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverage, not force"
          }
        }
      }
    },
    "tutorial.barre.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Barré-Akkorde brauchen Tage, nicht Minuten. Prüfe jede Saite einzeln und entspanne die Hand nach jedem Versuch. Sobald F sauber klingt, steht dir das ganze Griffbrett offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre chords take days, not minutes. Check each string on its own and relax the hand after every attempt. Once F rings clean, the whole fretboard opens up."
          }
        }
      }
    },
    "tutorial.barre.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geduld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patience"
          }
        }
      }
    },
    "tutorial.barre.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F-Dur knacken – mit Technik statt Kraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crack F major with technique instead of force."
          }
        }
      }
    },
    "tutorial.barre.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Barré-Akkord"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The barre chord"
          }
        }
      }
    },
    "tutorial.category.basics": {
      "extractionState": "manual",
      "localizations": {
