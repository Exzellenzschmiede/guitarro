    "coach.ai.card.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask anything about guitar. Knows your progress and answers in your language."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag alles rund um die Gitarre. Kennt deinen Fortschritt und antwortet in deiner Sprache."
          }
        }
      }
    },
    "coach.ai.card.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI coach"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Coach"
          }
        }
      }
    },
    "coach.ai.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New conversation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Gespräch"
          }
        }
      }
    },
    "coach.ai.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything about playing, practising or theory. A few ideas:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mich alles über Spielen, Üben oder Theorie. Ein paar Ideen:"
          }
        }
      }
    },
    "coach.ai.key.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in the Keychain on this device only. Get a key at console.anthropic.com. Leave empty to remove it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur im Schlüsselbund dieses Geräts gespeichert. Einen Schlüssel bekommst du auf console.anthropic.com. Leer lassen, um ihn zu entfernen."
          }
        }
      }
    },
    "coach.ai.key.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sk-ant-…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sk-ant-…"
          }
        }
      }
    },
    "coach.ai.key.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude API key"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-API-Schlüssel"
          }
        }
      }
    },
    "coach.ai.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the coach…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag den Coach …"
          }
        }
      }
    },
    "coach.ai.provider.claude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers come from Claude via your API key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten kommen von Claude über deinen API-Schlüssel."
          }
        }
      }
    },
    "coach.ai.provider.onDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on this device, nothing leaves it. For better answers, add a Claude key in Profile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf diesem Gerät, nichts verlässt es. Für bessere Antworten: Claude-Schlüssel im Profil."
          }
        }
      }
    },
    "coach.ai.setup.addKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add API key"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel hinterlegen"
          }
        }
      }
    },
    "coach.ai.setup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot run the on-device model. You can use Claude instead with your own API key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann das On-Device-Modell nicht ausführen. Alternativ nutzt du Claude mit deinem eigenen API-Schlüssel."
          }
        }
      }
    },
    "coach.ai.setup.enableAppleIntelligence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in Settings to use the on-device coach, or use Claude with your own API key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Apple Intelligence in den Einstellungen ein, um den On-Device-Coach zu nutzen, oder nutze Claude mit deinem eigenen API-Schlüssel."
          }
        }
      }
    },
    "coach.ai.setup.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model is still downloading. Try again later, or use Claude with your own API key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das On-Device-Modell wird noch geladen. Versuch es später erneut oder nutze Claude mit deinem eigenen API-Schlüssel."
          }
        }
      }
    },
    "coach.ai.setup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the coach"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach einrichten"
          }
        }
      }
    },
    "coach.ai.suggestion.buzz": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does my F chord buzz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum schnarrt mein F-Akkord?"
          }
        }
      }
    },
    "coach.ai.suggestion.plan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me a 10-minute practice plan for today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib mir einen 10-Minuten-Übungsplan für heute."
          }
        }
      }
    },
    "coach.ai.suggestion.song": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which song in the app should I learn next?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welchen Song in der App sollte ich als Nächstes lernen?"
          }
        }
      }
    },
    "coach.ai.suggestion.theory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain the difference between major and minor in simple words."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkläre mir den Unterschied zwischen Dur und Moll in einfachen Worten."
          }
        }
      }
    },
    "coach.ai.title": {
      "extractionState": "manual",
      "localizations": {
