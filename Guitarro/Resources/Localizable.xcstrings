    "coach.hint.thumbOverNeck": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daumen hinter den Hals, etwa gegenüber dem Mittelfinger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumb behind the neck, roughly opposite your middle finger."
          }
        }
      }
    },
