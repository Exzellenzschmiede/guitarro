        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the hand closer to the camera."
          }
        }
      }
    },
    "coach.hint.noHand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig mir deine Greifhand."
