    },
    "tutorial.tuning.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von dick nach dünn: E, A, D, G, H, E. Die dicke E-Saite klingt am tiefsten und liegt oben, wenn du die Gitarre hältst. Merkhilfe: „Eine Alte Dame Ging Heringe Essen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From thick to thin: E, A, D, G, B, E. The thick E string sounds lowest and sits on top when you hold the guitar. Memory aid: “Eddie Ate Dynamite, Good Bye Eddie”."
          }
        }
      }
    },
    "tutorial.tuning.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sechs Saiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The six strings"
          }
        }
      }
    },
    "tutorial.tuning.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele eine Saite und lass sie ausklingen. Die Nadel zeigt, ob der Ton zu tief (links) oder zu hoch (rechts) ist. Drehe den Wirbel langsam, bis die Nadel in der Mitte grün wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play one string and let it ring. The needle shows whether the note is flat (left) or sharp (right). Turn the peg slowly until the needle settles in the green centre."
          }
        }
      }
    },
    "tutorial.tuning.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzeige lesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the gauge"
          }
        }
      }
    },
    "tutorial.tuning.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimme immer von zu tief nach oben. Ist die Saite zu hoch, drehe sie etwas herunter und dann wieder hinauf – so bleibt die Stimmung stabil. Probiere es jetzt mit allen sechs Saiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always approach the pitch from below. If a string is sharp, tune it down a little and then back up, so the tuning holds. Try it now with all six strings."
          }
        }
      }
    },
    "tutorial.tuning.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer von unten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always tune up"
          }
        }
      }
    },
    "tutorial.tuning.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sechs Saiten, ihre Namen und wie du sie mit dem Stimmgerät triffst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The six strings, their names and how to nail them with the tuner."
          }
        }
      }
    },
