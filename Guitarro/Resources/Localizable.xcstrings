    "story.hillHouse.ch1.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele Am, E und wieder Am. Langsam. Lass jeden Akkord im Raum stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play Am, E and Am again. Slowly. Let every chord hang in the room."
          }
        }
      }
    },
    "story.hillHouse.ch1.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "… du spielst meine Akkorde. Niemand hat sie hier gespielt, seit ich gegangen bin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… you're playing my chords. Nobody has played them here since I left."
          }
        }
      }
    },
    "story.hillHouse.ch1.ch1.a": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Ich will wissen, wer da spielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. I want to know who's playing."
          }
        }
      }
    },
    "story.hillHouse.ch1.ch1.a.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann nimm die Gitarre mit. Wer auch immer da oben ist, hört auf Musik, nicht auf Worte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then take the guitar. Whoever is up there listens to music, not words."
          }
        }
      }
    },
    "story.hillHouse.ch1.ch1.b": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin mir nicht sicher …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm not sure …"
          }
        }
      }
    },
    "story.hillHouse.ch1.ch1.b.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik hat noch nie jemandem geschadet. Nimm sie mit, und du bist nicht allein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music has never hurt anyone. Take it with you and you won't be alone."
          }
        }
      }
    },
    "story.hillHouse.ch1.ch1.prompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willst du wirklich da hoch?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really want to go up there?"
          }
        }
      }
    },
    "story.hillHouse.ch1.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Haus am Hügel steht seit Jahren leer. Trotzdem hört das ganze Dorf in klaren Nächten Gitarre von dort oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The house on the hill has stood empty for years. Yet on clear nights the whole village hears a guitar from up there."
          }
        }
      }
    },
    "story.hillHouse.ch1.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war Lenas Haus. Sie hat gespielt, als wär die Gitarre ein Teil von ihr. Bis zu dem Winter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was Lena's house. She played as if the guitar were part of her. Until that winter."
          }
        }
      }
    },
    "story.hillHouse.ch1.d2.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tür ist nicht abgeschlossen. Im Salon steht ein Stuhl, mitten im Mondlicht, als würde er auf dich warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The door isn't locked. In the parlour stands a chair, right in the moonlight, as if it were waiting for you."
          }
        }
      }
    },
    "story.hillHouse.ch1.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Haus, das nachts Musik macht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A house that makes music at night"
          }
        }
      }
    },
    "story.hillHouse.ch1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerücht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rumour"
          }
        }
      }
    },
    "story.hillHouse.ch2.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A, H, C, D, E, D, C, A. Jeden Ton so, wie der Wind ihn dir gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A, B, C, D, E, D, C, A. Each note just as the wind gives it to you."
          }
        }
      }
    },
    "story.hillHouse.ch2.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. Genau so. Ich hatte vergessen, wie sie klingt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. Exactly like that. I had forgotten how it sounds."
          }
        }
      }
    },
    "story.hillHouse.ch2.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin Lena. Oder das, was von ihr noch Musik machen kann. Ich habe eine Melodie angefangen und nie beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm Lena. Or whatever is left of her that can still make music. I started a melody and never finished it."
          }
        }
      }
    },
    "story.hillHouse.ch2.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig sie mir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show me."
          }
        }
      }
    },
    "story.hillHouse.ch2.d1.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör in den Wind. Er trägt sie schon seit Jahren durch das Haus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen to the wind. It has carried it through the house for years."
          }
        }
      }
    },
    "story.hillHouse.ch2.d2.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Draußen legt sich der Wind. Zum ersten Mal seit Jahren ist es still um das Haus – aber nicht leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside the wind settles. For the first time in years it is quiet around the house, but not empty."
          }
        }
      }
    },
    "story.hillHouse.ch2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Töne aus dem Nichts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight notes out of nowhere"
          }
        }
      }
    },
    "story.hillHouse.ch2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Melodie im Wind"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The melody on the wind"
          }
        }
      }
    },
    "story.hillHouse.ch3.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am und Dm, im Wechsel, eine Minute lang. Die Schatten folgen deinen Händen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Am and Dm, alternating, for one minute. The shadows follow your hands."
          }
        }
      }
    },
    "story.hillHouse.ch3.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich hab das Licht oben gesehen, von der Straße aus. Das ganze Dorf hat es gesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I saw the light up there, from the road. The whole village saw it."
          }
        }
      }
    },
    "story.hillHouse.ch3.ch1.a": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam. Wie ein Walzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow. Like a waltz."
          }
        }
      }
    },
    "story.hillHouse.ch3.ch1.a.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam ist gut. Langsam heißt, jeder Akkord kommt an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow is good. Slow means every chord arrives."
          }
        }
      }
    },
    "story.hillHouse.ch3.ch1.b": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell. Sie sollen wirbeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast. Let them whirl."
          }
        }
      }
    },
    "story.hillHouse.ch3.ch1.b.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann halt die Wechsel sauber, sonst stolpern sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then keep the changes clean, or they'll trip."
          }
        }
      }
    },
    "story.hillHouse.ch3.ch1.prompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen die Schatten schnell oder langsam tanzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should the shadows dance fast or slow?"
          }
        }
      }
    },
    "story.hillHouse.ch3.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zweite Nacht. Im Ballsaal bewegen sich Schatten an der Wand, als würde jemand tanzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The second night. In the ballroom shadows move along the wall as if someone were dancing."
          }
        }
      }
    },
    "story.hillHouse.ch3.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Eltern haben hier getanzt. Zu Am und Dm, immer im Wechsel. Kannst du das halten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My parents danced here. To Am and Dm, always alternating. Can you hold that?"
          }
        }
      }
    },
    "story.hillHouse.ch3.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am und Dm im Takt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Am and Dm in time"
          }
        }
      }
    },
    "story.hillHouse.ch3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanz der Schatten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dance of the shadows"
          }
        }
      }
    },
    "story.hillHouse.ch4.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„House of the Rising Sun“. Spiel es für mich, einmal bis zum Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“House of the Rising Sun”. Play it for me, once, all the way to the end."
          }
        }
      }
    },
    "story.hillHouse.ch4.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim letzten Akkord gehen im ganzen Haus die Lichter an. Und dann, ganz sanft, wieder aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the last chord every light in the house comes on. And then, very gently, goes out again."
          }
        }
      }
    },
    "story.hillHouse.ch4.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die dritte Nacht. Das halbe Dorf steht mit Laternen am Fuß des Hügels. Opa Hannes hat seine alte Gitarre dabei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The third night. Half the village stands at the foot of the hill with lanterns. Grandpa Hannes has brought his old guitar."
          }
        }
      }
    },
    "story.hillHouse.ch4.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gab ein Lied, das sie immer zuletzt gespielt hat. Wenn du es spielst, kann sie gehen. Ich glaube, sie will das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was a song she always played last. If you play it, she can go. I think she wants to."
          }
        }
      }
    },
    "story.hillHouse.ch4.d2.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Die Melodie gehört jetzt dir. Bring sie nach draußen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you. The melody is yours now. Take it outside."
          }
        }
      }
    },
    "story.hillHouse.ch4.d2.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm. Unten wartet Kaffee, und die Leute wollen wissen, was du da oben gespielt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come on. There's coffee waiting below, and people want to know what you played up there."
          }
        }
      }
    },
    "story.hillHouse.ch4.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "House of the Rising Sun"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "House of the Rising Sun"
          }
        }
      }
    },
    "story.hillHouse.ch4.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das letzte Lied"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last song"
          }
        }
      }
    },
    "story.hillHouse.tagline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der alten Villa spielt nachts jemand Gitarre. Finde heraus, wer – mit Moll-Akkorden und einer Melodie im Wind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone plays guitar in the old villa at night. Find out who, with minor chords and a melody on the wind."
          }
        }
      }
    },
    "story.hillHouse.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Haus am Hügel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The House on the Hill"
          }
        }
      }
    },
    "story.kicker": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Story-Modus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story mode"
          }
        }
      }
    },
