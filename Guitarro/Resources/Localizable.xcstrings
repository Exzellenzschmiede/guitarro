            "value": "sk-ant-…"
          }
        }
      }
    },
    "coach.ai.key.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-API-Schlüssel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude API key"
          }
        }
      }
    },
    "coach.ai.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag den Coach …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the coach…"
          }
        }
      }
    },
    "coach.ai.provider.claude": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten kommen von Claude über deinen API-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers come from Claude via your API key."
          }
        }
      }
    },
    "coach.ai.provider.onDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf diesem Gerät, nichts verlässt es. Für bessere Antworten: Claude-Schlüssel im Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on this device, nothing leaves it. For better answers, add a Claude key in Profile."
          }
        }
      }
    },
    "coach.ai.setup.addKey": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel hinterlegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add API key"
          }
        }
      }
    },
    "coach.ai.setup.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann das On-Device-Modell nicht ausführen. Alternativ nutzt du Claude mit deinem eigenen API-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device cannot run the on-device model. You can use Claude instead with your own API key."
          }
        }
      }
    },
    "coach.ai.setup.enableAppleIntelligence": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Apple Intelligence in den Einstellungen ein, um den On-Device-Coach zu nutzen, oder nutze Claude mit deinem eigenen API-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in Settings to use the on-device coach, or use Claude with your own API key."
          }
        }
      }
    },
    "coach.ai.setup.modelNotReady": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das On-Device-Modell wird noch geladen. Versuch es später erneut oder nutze Claude mit deinem eigenen API-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model is still downloading. Try again later, or use Claude with your own API key."
          }
        }
      }
    },
    "coach.ai.setup.title": {
      "extractionState": "manual",
      "localizations": {
