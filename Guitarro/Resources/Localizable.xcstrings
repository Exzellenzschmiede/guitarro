    "coach.ai.card.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag alles rund um die Gitarre. Kennt deinen Fortschritt und antwortet in deiner Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask anything about guitar. Knows your progress and answers in your language."
          }
        }
      }
    },
    "coach.ai.card.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Coach"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI coach"
          }
        }
      }
    },
    "coach.ai.clear": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Gespräch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New conversation"
          }
        }
      }
    },
    "coach.ai.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mich alles über Spielen, Üben oder Theorie. Ein paar Ideen:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything about playing, practising or theory. A few ideas:"
          }
        }
      }
    },
    "coach.ai.key.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur im Schlüsselbund dieses Geräts gespeichert. Einen Schlüssel bekommst du auf console.anthropic.com. Leer lassen, um ihn zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in the Keychain on this device only. Get a key at console.anthropic.com. Leave empty to remove it."
          }
        }
      }
    },
    "coach.ai.key.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sk-ant-…"
          }
        },
        "en": {
