    },
    "story.roadtrip.ch1.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "G, D, Em, C. Jeden Akkord sauber anschlagen und klingen lassen. Dann hast du deinen ersten Song im Blut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "G, D, Em, C. Strum each chord cleanly and let it ring. Then your first song is in your blood."
          }
        }
      }
    },
    "story.roadtrip.ch1.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörst du das? Das ist der Sound von hundert Sommerhits. Weiter geht's."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hear that? That's the sound of a hundred summer hits. Let's roll."
          }
        }
      }
    },
    "story.roadtrip.ch1.ch1.a": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich spiele. Gib mir die Gitarre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I play. Hand me the guitar."
          }
        }
      }
    },
    "story.roadtrip.ch1.ch1.a.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So gefällt mir das. G, D, Em, C – das ist die halbe Radiogeschichte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's what I like to hear. G, D, Em, C is half the history of radio."
          }
        }
      }
    },
    "story.roadtrip.ch1.ch1.b": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fahre erst mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll drive for now."
          }
        }
      }
    },
    "story.roadtrip.ch1.ch1.b.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, aber am ersten Rastplatz bist du dran. Ich zähle die Kilometer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine, but at the first rest stop you're on. I'm counting the kilometres."
          }
        }
      }
    },
    "story.roadtrip.ch1.ch1.prompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fährst du die erste Etappe oder spielst du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you drive the first leg or do you play?"
          }
        }
      }
    },
    "story.roadtrip.ch1.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommer. Der Van riecht nach Kaffee und altem Teppich. Nova sitzt auf dem Beifahrersitz, Jules trommelt aufs Armaturenbrett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer. The van smells of coffee and old carpet. Nova is in the passenger seat, Jules is drumming on the dashboard."
          }
        }
      }
    },
    "story.roadtrip.ch1.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Tage bis zum Festival. Und wir haben keinen Gitarristen. Also: du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three days to the festival. And we have no guitarist. So: you."
          }
        }
      }
    },
    "story.roadtrip.ch1.d1.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Panik. Fast jeder Song da draußen besteht aus denselben vier Akkorden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No panic. Almost every song out there is made of the same four chords."
          }
        }
      }
    },
    "story.roadtrip.ch1.d2.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastplatz. Motor aus. Jules holt die Gitarre vom Rücksitz und drückt sie dir in die Hand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest stop. Engine off. Jules grabs the guitar from the back seat and puts it in your hands."
          }
        }
      }
    },
    "story.roadtrip.ch1.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Akkorde und ein voller Tank"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four chords and a full tank"
          }
        }
      }
    },
    "story.roadtrip.ch1.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abfahrt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departure"
          }
        }
      }
    },
    "story.roadtrip.ch2.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Minute. G zu D und zurück, so oft du kannst, ohne dass ein Ton stirbt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One minute. G to D and back, as often as you can without a single note dying."
          }
        }
      }
    },
    "story.roadtrip.ch2.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Loch ist weg. Jetzt könnte ich dazu singen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hole is gone. Now I could actually sing to that."
          }
        }
      }
    },
    "story.roadtrip.ch2.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitternacht. Die Tankstelle flackert grün und rosa. Jules kauft Chips, Nova lehnt am Van und summt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Midnight. The gas station flickers green and pink. Jules buys crisps, Nova leans on the van and hums."
          }
        }
      }
    },
    "story.roadtrip.ch2.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein G klingt gut. Dein D auch. Aber dazwischen ist ein Loch, in das ein Lastwagen passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your G sounds good. So does your D. But between them is a hole you could park a truck in."
          }
        }
      }
    },
    "story.roadtrip.ch2.d2.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel ist der Song. Nicht die Akkorde. Der Wechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change is the song. Not the chords. The change."
          }
        }
      }
    },
    "story.roadtrip.ch2.d3.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Van rollt zurück auf die Landstraße. Im Rückspiegel wird die Tankstelle zu einem kleinen Stern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The van rolls back onto the country road. In the mirror the gas station shrinks to a small star."
          }
        }
      }
    },
    "story.roadtrip.ch2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsel im Neonlicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes in neon light"
          }
        }
      }
    },
    "story.roadtrip.ch2.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankstelle bei Nacht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gas station at night"
          }
        }
      }
    },
    "story.roadtrip.ch3.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "G, A, H, D, H, A, G. Jeden Ton einzeln, klar und ruhig. Das ist unser Intro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "G, A, B, D, B, A, G. Each note on its own, clear and calm. That's our intro."
          }
        }
      }
    },
    "story.roadtrip.ch3.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war's. Genau das. Wenn der Abschleppwagen kommt, spielen wir es ihm vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's it. Exactly that. When the tow truck comes, we'll play it for the driver."
          }
        }
      }
    },
    "story.roadtrip.ch3.ch1.a": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam. Ton für Ton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow. Note by note."
          }
        }
      }
    },
    "story.roadtrip.ch3.ch1.a.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kluge Wahl. Langsam richtig ist schneller als schnell falsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart. Slow and right is faster than fast and wrong."
          }
        }
      }
    },
    "story.roadtrip.ch3.ch1.b": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleich im Tempo!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight to tempo!"
          }
        }
      }
    },
    "story.roadtrip.ch3.ch1.b.response": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha! Ich mag deinen Mut. Aber hör zu, was Jules dir zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha! I like your nerve. But listen to what Jules shows you."
          }
        }
      }
    },
    "story.roadtrip.ch3.ch1.prompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willst du das Riff langsam oder gleich im Tempo?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want the riff slow or straight up to tempo?"
          }
        }
      }
    },
    "story.roadtrip.ch3.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Knall, dann Dampf. Der Van steht am Straßenrand zwischen Sonnenblumen. Der Abschleppdienst kommt in zwei Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bang, then steam. The van sits on the roadside between sunflowers. The tow truck will take two hours."
          }
        }
      }
    },
    "story.roadtrip.ch3.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Stunden. Weißt du, was man in zwei Stunden lernen kann? Ein Riff, das Leute zum Umdrehen bringt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two hours. You know what you can learn in two hours? A riff that makes people turn their heads."
          }
        }
      }
    },
    "story.roadtrip.ch3.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Riff gegen die Langeweile"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A riff against boredom"
          }
        }
      }
    },
    "story.roadtrip.ch3.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Panne"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The breakdown"
          }
        }
      }
    },
    "story.roadtrip.ch4.c1.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib bei den Akkorden, egal was passiert. Das Publikum verzeiht alles, nur kein Aufhören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay on the chords, whatever happens. The crowd forgives everything except stopping."
          }
        }
      }
    },
    "story.roadtrip.ch4.c1.success": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Akkord verklingt. Einen Moment ist es still. Dann bricht das Feld in Jubel aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last chord fades. For a moment it's silent. Then the whole field erupts."
          }
        }
      }
    },
    "story.roadtrip.ch4.d1.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abends. Lichterketten über einem Feld, tausend Leute, Staub in der Luft. Hinter der Bühne zittern deine Hände ein bisschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening. String lights over a field, a thousand people, dust in the air. Backstage your hands shake a little."
          }
        }
      }
    },
    "story.roadtrip.ch4.d1.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Song. Wir spielen „When the Saints“. Du hältst die Akkorde, ich singe, Jules trommelt. Bereit?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One song. We're playing “When the Saints”. You hold the chords, I sing, Jules drums. Ready?"
          }
        }
      }
    },
    "story.roadtrip.ch4.d2.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht schlecht für jemanden, der vor drei Tagen noch fahren wollte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not bad for someone who wanted to drive three days ago."
          }
        }
      }
    },
    "story.roadtrip.ch4.d2.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächstes Jahr wieder? Dann mit eigenen Songs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same again next year? With our own songs then."
          }
        }
      }
    },
    "story.roadtrip.ch4.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Song, ein Festival"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One song, one festival"
          }
        }
      }
    },
    "story.roadtrip.ch4.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bühne"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stage"
          }
        }
      }
    },
    "story.roadtrip.tagline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein alter Van, zwei Freunde und ein Festival am Ende der Straße. Vier Akkorde bringen dich hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old van, two friends and a festival at the end of the road. Four chords will get you there."
          }
        }
      }
    },
    "story.roadtrip.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Roadtrip"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roadtrip"
          }
        }
      }
    },
