    "coach.hint.flatFinger %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arch your %@: a flat finger mutes the neighbouring string."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wölbe den %@: Ein flacher Finger dämpft die Nachbarsaite."
          }
        }
      }
    },
    "coach.hint.flatFingers %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arch %@: flat fingers mute the neighbouring strings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wölbe %@: Flache Finger dämpfen die Nachbarsaiten."
          }
        }
      }
    },
    "coach.hint.lookingGood": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking good. Keep the fingers arched."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht gut aus. Finger schön gewölbt halten."
          }
        }
      }
    },
    "coach.hint.moveCloser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the hand closer to the camera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Hand näher an die Kamera."
          }
        }
      }
    },
    "coach.hint.noHand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show me your fretting hand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeig mir deine Greifhand."
          }
        }
      }
    },
    "coach.hint.thumbOverNeck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumb behind the neck, roughly opposite your middle finger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daumen hinter den Hals, etwa gegenüber dem Mittelfinger."
          }
        }
      }
    },
    "coach.noCamera.body": {
      "extractionState": "manual",
      "localizations": {
