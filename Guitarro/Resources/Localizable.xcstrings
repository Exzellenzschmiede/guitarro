    "coach.setup.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell das Gerät etwa eine Armlänge vor dir auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prop the device up in front of you, about an arm's length away."
          }
        }
      }
    },
    "coach.setup.2": {
      "extractionState": "manual",
      "localizations": {
