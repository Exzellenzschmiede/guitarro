    "coach.card.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera watches your fretting hand: finger arch and thumb position."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera beobachtet deine Greifhand: Fingerwölbung und Daumenposition."
          }
        }
      }
    },
    "coach.card.title": {
      "extractionState": "manual",
      "localizations": {
