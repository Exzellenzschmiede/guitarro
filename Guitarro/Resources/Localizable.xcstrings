    "coach.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitarro nutzt die Kamera, um deine Greifhand zu beobachten. Es wird nichts aufgezeichnet oder hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitarro uses the camera to watch your fretting hand. Nothing is recorded or uploaded."
          }
        }
      }
    },
    "coach.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
