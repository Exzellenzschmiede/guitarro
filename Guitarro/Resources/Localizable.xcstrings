    "coach.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitarro uses the camera to watch your fretting hand. Nothing is recorded or uploaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitarro nutzt die Kamera, um deine Greifhand zu beobachten. Es wird nichts aufgezeichnet oder hochgeladen."
          }
        }
      }
    },
    "coach.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access needed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff nötig"
          }
        }
      }
    },
    "coach.setup.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prop the device up in front of you, about an arm's length away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell das Gerät etwa eine Armlänge vor dir auf."
          }
        }
      }
    },
    "coach.setup.2": {
      "extractionState": "manual",
      "localizations": {
