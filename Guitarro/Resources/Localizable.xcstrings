{
  "sourceLanguage": "en",
  "strings": {
    "chord.hint.augmented": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Terz und übermäßige Quinte: geheimnisvoll und unaufgelöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Major third and a raised fifth: mysterious and unresolved."
          }
        }
      }
    },
    "chord.hint.diminished": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Terz und verminderte Quinte: spannungsreich und instabil, oft als Durchgangsakkord verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minor third and a flattened fifth: tense and unstable, often used as a passing chord."
          }
        }
      }
    },
    "chord.hint.dominantSeventh": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Dur-Akkord plus kleine Septime. Die zusätzliche Spannung will sich zum Akkord eine Quarte höher auflösen (E7 → A)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A major chord plus a minor seventh. The added tension wants to resolve to the chord a fourth higher (E7 → A)."
          }
        }
      }
    },
    "chord.hint.major": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundton, große Terz und Quinte. Die große Terz (4 Halbtöne über dem Grundton) sorgt für den hellen, fröhlichen Klang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root, major third and fifth. The major third (4 semitones above the root) gives the bright, happy sound."
          }
        }
      }
    },
    "chord.hint.majorSeventh": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Dur-Akkord plus große Septime: verträumt und offen, typisch für Pop und Bossa Nova."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A major chord plus a major seventh: dreamy and open, common in pop and bossa nova."
          }
        }
      }
    },
    "chord.hint.minor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundton, kleine Terz und Quinte. Die um einen Halbton tiefere Terz lässt den Akkord dunkler und trauriger klingen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root, minor third and fifth. Lowering the third by one semitone makes the chord sound darker and sadder."
          }
        }
      }
    },
    "chord.hint.minorSeventh": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Moll-Akkord plus kleine Septime: weich, warm und ein wenig jazzig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minor chord plus a minor seventh: soft, mellow and a little jazzy."
          }
        }
      }
    },
    "chord.hint.suspendedFourth": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Terz ist durch die Quarte ersetzt. Das erzeugt Spannung, die sich meist zurück zum Dur-Akkord auflöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The third is replaced by the fourth. It creates tension that usually resolves back to the major chord."
          }
        }
      }
    },
    "chord.hint.suspendedSecond": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Terz ist durch die Sekunde ersetzt, der Akkord ist also weder Dur noch Moll. Er klingt offen und schwebend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The third is replaced by the second, so the chord is neither major nor minor. It sounds open and floating."
          }
        }
      }
    },
    "chord.quality.augmented": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übermäßig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmented"
          }
        }
      }
    },
