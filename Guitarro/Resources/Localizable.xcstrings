    "usersongs.learn.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This track plays through the system player. Play it once through the speaker: Guitarro listens with the microphone and writes down the chords with timestamps. Afterwards you can loop, slow down and play along with headphones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Titel läuft über den Systemplayer. Spiel ihn einmal über den Lautsprecher ab: Guitarro hört mit dem Mikrofon zu und schreibt die Akkorde mit Zeitstempeln mit. Danach kannst du loopen, verlangsamen und mit Kopfhörern mitspielen."
          }
        }
      }
    },
    "usersongs.learn.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish now"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt beenden"
          }
        }
      }
    },
    "usersongs.learn.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chords were learned through the microphone. Room noise can cause mistakes; learn again in a quiet room if needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Akkorde wurden über das Mikrofon gelernt. Raumgeräusche können Fehler verursachen; bei Bedarf in einem ruhigen Raum erneut lernen."
          }
        }
      }
    },
