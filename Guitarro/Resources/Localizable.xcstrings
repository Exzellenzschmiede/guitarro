    "tutorial.tryIt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt ausprobieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it now"
          }
        }
