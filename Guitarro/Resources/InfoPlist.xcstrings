    "NSAppleMusicUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guitarro liest Songs aus deiner Mediathek, um ihre Akkorde auf diesem Gerät zu analysieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guitarro reads songs from your library to analyse their chords on this device."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guitarro beobachtet deine Greifhand, um dir Feedback zur Haltung zu geben. Es wird nichts aufgezeichnet oder hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guitarro watches your fretting hand to give you posture feedback. Nothing is recorded or uploaded."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guitarro hört deine Gitarre, um sie zu stimmen und dir beim Spielen Feedback zu geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guitarro listens to your guitar to tune it and give you feedback while you play."
          }
        }
      }
    }
